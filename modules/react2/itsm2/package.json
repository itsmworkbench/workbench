    "@itsmworkbench/itsmsovereign": "1.0.1",
    "@itsmworkbench/itsm_state": "1.0.1",
    "@itsmworkbench/itsm_translation": "1.0.1",
    "@itsmworkbench/jsyaml": "1.0.1",
    "@itsmworkbench/knowledgearticle": "1.0.1",
    "@itsmworkbench/newticket_wizard": "1.0.1",
    "@itsmworkbench/panelnavigator": "1.0.1",
