{
  "name": "@itsmworkbench/common_components",
  "description": "A selection of commonly used components. This is so that we can have MUI implementations, or other implementations and the majority of the code doesn't care",
  "version": "1.0.0",
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
  "dependencies": {
    "@itsmworkbench/clip_height": "1.0.0",
    "@itsmworkbench/layouts": "1.0.0",
    "@itsmworkbench/loading": "1.0.0",
    "@itsmworkbench/mouse_over": "1.0.0",
    "@itsmworkbench/panelnavigator": "1.0.0",
    "@itsmworkbench/react_utils": "1.0.0",
    "@itsmworkbench/rows_and_panels": "1.0.0",
    "@itsmworkbench/secrets": "1.0.0",
    "@itsmworkbench/selectable_button": "1.0.0",
    "@itsmworkbench/system": "1.0.0",
    "@itsmworkbench/table": "1.0.0",
    "@itsmworkbench/translation": "1.0.0",
    "debug": "^4.3.4",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@focuson/lens": "1.44.3",
    "@focuson/state": "1.44.3",
    "@laoban/utils": "1.4.45",
    "@mui/material": "^5.15.10",
    "@mui/icons-material": "^5.15.10",
    "@material-ui/core": "^4.12.4"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.2",
    "typescript": "^5.2.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^15.0.6",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/react": "^18.2.33",
    "@types/react-dom": "^18.2.14",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest": "^29.2.5",
    "ts-jest": "^29.2.5"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "files": [
    "build/",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/src/",
    "build/"
  ],
  "keywords": [
    "react",
    "runbook"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "repository": "git@github.com:intellimaintain/intellimaintain.git",
  "scripts": {
    "start": "parcel src/index.html",
    "build": "parcel build src/index.html",
    "test": "jest --config jest.config.json",
    "test:watch": "npm run test -- --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "type": "module"
}