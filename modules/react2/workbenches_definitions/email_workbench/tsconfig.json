{
  "compilerOptions": {
    "jsx":              "react",
    "module": "ESNext",
    "target":           "ES2022",
    "outDir":           "./dist",
    "moduleResolution": "node",
    "declaration":      true,
    "allowJs":          false,
    "skipLibCheck":     true,
    "esModuleInterop":  true
  },
  "include":         ["src/**/*.ts", "src/**/*.tsx", "index.ts", "src/global.d.ts"],
  "exclude":         ["dist/**/*.ts"]
}